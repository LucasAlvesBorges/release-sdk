{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/django-validate-commit.sh\"",
            "timeout": 5,
            "statusMessage": "Validating commit message..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/release-agents-md-guard.js\"",
            "timeout": 5,
            "statusMessage": "Checking AGENTS.md gate..."
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-edit-adapter.js\" \"${PLUGIN_ROOT}/hooks/django-workflow-guard.js\"",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-edit-adapter.js\" \"${PLUGIN_ROOT}/hooks/django-prompt-guard.js\"",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-edit-adapter.js\" \"${PLUGIN_ROOT}/hooks/django-tenant-scope-check.sh\"",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-edit-adapter.js\" \"${PLUGIN_ROOT}/hooks/react-workflow-guard.js\"",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-edit-adapter.js\" \"${PLUGIN_ROOT}/hooks/react-security-guard.js\"",
            "timeout": 8
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/release-context-monitor.js\"",
            "timeout": 4,
            "statusMessage": "Tracking Codex context..."
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/release-token-collector.js\"",
            "timeout": 4
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/release-token-collector.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
