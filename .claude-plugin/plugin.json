{
  "name": "release",
  "description": "Adaptive Django, React and React Native delivery for Claude Code: compact spec/plan, proportional C0-C4 execution, explicit bounded loops, focused tests, worktree isolation and security checks.",
  "version": "0.26.0",
  "author": {
    "name": "Lucas Alves Borges",
    "email": "cco@startecservicos.com.br"
  },
  "homepage": "https://github.com/LucasAlvesBorges/release-sdk",
  "repository": "https://github.com/LucasAlvesBorges/release-sdk",
  "license": "MIT",
  "keywords": [
    "django",
    "drf",
    "react",
    "react-native",
    "expo",
    "tsx",
    "typescript",
    "fullstack",
    "tdd",
    "security",
    "performance",
    "multi-tenancy",
    "zustand",
    "tanstack-query",
    "vitest",
    "n-plus-one",
    "race-conditions"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/release-efficiency-context.js\" SessionStart",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/release-efficiency-context.js\" SubagentStart",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/django-validate-commit.sh\"",
            "timeout": 5,
            "statusMessage": "Validating commit message..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/release-edit-guard.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/release-token-collector.js\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/release-token-collector.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
